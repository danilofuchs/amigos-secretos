{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    ".impeccable/**",
    "AGENTS.md",
    "DESIGN.md",
    "PRODUCT.md",
    "public/**"
  ]
}
